{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "files", "findings"],
  "properties": {
    "summary": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "decision", "testFiles", "reason"],
        "properties": {
          "source": {
            "type": "string"
          },
          "decision": {
            "enum": ["create", "update", "none", "skip"]
          },
          "testFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
